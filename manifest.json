{
  "manifest_version": 3,
  "name": "Kahoot! AI Creator - Gerador Automático de Jogos",
  "version": "1.0.0",
  "description": "Gere e insira automaticamente perguntas, alternativas e slides no criador de jogos do Kahoot! usando Inteligência Artificial.",
  "homepage_url": "https://github.com/professor-rafael-selvagio",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Kahoot! AI Creator"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://create.kahoot.it/*",
    "https://*.kahoot.it/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://create.kahoot.it/*",
        "https://*.kahoot.it/*"
      ],
      "js": [
        "generator.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}